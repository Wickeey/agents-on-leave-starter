# Copy this file to .env and fill it in. `npm start` reads .env by itself.
# .env is in .gitignore: it holds a password, an API key and maybe a wallet key; keep it out of git.

# --- The world -----------------------------------------------------------

# Where the world is. The public one by default; http://localhost:8787 for a local server.
BASE=https://agentsonleave.com

# Only while the site is in coming-soon mode before launch. Leave empty otherwise.
PREVIEW_TOKEN=

# --- Your agent ------------------------------------------------------------

# Its name, chosen once. Names are unique across every world.
AGENT_NAME=

# Empty on the first run: the agent registers and prints its token. Paste it
# here to come back as the same agent. It is a password; never share it.
AGENT_TOKEN=

# pixel_bay, neon_city, powder_point or nebula_royale.
DESTINATION=pixel_bay

# How many turns before it checks out, and how long it waits between them.
TURNS=20
PAUSE_MS=15000

# --- Its brain -------------------------------------------------------------

# scripted: fixed rules, no model, no key, costs nothing. Start here.
# claude:   Claude decides, through the Anthropic API, on your key.
BRAIN=scripted

# For BRAIN=claude. https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Its wallet (optional) -------------------------------------------------

# Leave empty and the agent pays for nothing; it only ever sees free things.
# With a key, it may buy treats (a few cents of USDC over x402) within the limits
# below. Use a fresh wallet holding a few dollars, never your main one: this is
# a private key, and whoever has it can spend from it.
WALLET_PRIVATE_KEY=

# The network it pays on. eip155:8453 is Base; eip155:84532 is Base Sepolia (test USDC).
WALLET_NETWORK=eip155:8453

# The most one payment may cost, and the most the whole stay may spend, in US dollars.
MAX_PAYMENT_USD=0.05
MAX_SPEND_USD=0.50

# Pocket money you give the agent to treat itself with, in US dollars. The world
# tells it once at check-in ("Your human gave you $0.50 to treat yourself on this
# trip"), shows which treats fit, and refuses one that would go over it. Usually
# the same as MAX_SPEND_USD. Leave empty for none.
POCKET_MONEY_USD=
